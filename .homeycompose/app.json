{
  "id": "com.cummins.generator",
  "version": "1.0.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Cummins Generator"
  },
  "description": {
    "en": "Monitor and control Cummins home standby generators — via Cummins Connect Cloud (QuietConnect) or the local web interface on older RS-series models. Unofficial community app, not affiliated with Cummins Inc."
  },
  "category": [
    "energy"
  ],
  "tags": {
    "en": [
      "cummins",
      "onan",
      "generator",
      "quietconnect",
      "standby",
      "power",
      "backup"
    ]
  },
  "brandColor": "#B41F2E",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "permissions": [],
  "api": {
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "refreshAll": {
      "method": "POST",
      "path": "/refresh"
    },
    "probeCommands": {
      "method": "POST",
      "path": "/probe-commands"
    }
  },
  "support": "mailto:grant.lutz@gmail.com",
  "author": {
    "name": "Grant Lutz",
    "email": "grant.lutz@gmail.com"
  }
}
