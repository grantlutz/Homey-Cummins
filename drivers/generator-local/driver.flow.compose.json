{
  "triggers": [
    {
      "id": "local_generator_started",
      "title": {
        "en": "The generator started"
      },
      "highlight": true
    },
    {
      "id": "local_generator_stopped",
      "title": {
        "en": "The generator stopped"
      },
      "highlight": true,
      "tokens": [
        {
          "name": "runtime_hours",
          "type": "number",
          "title": {
            "en": "Total runtime (h)"
          },
          "example": 27.6
        }
      ]
    },
    {
      "id": "local_utility_lost",
      "title": {
        "en": "Utility power was lost"
      },
      "highlight": true
    },
    {
      "id": "local_utility_restored",
      "title": {
        "en": "Utility power was restored"
      },
      "highlight": true
    },
    {
      "id": "local_switched_to_generator",
      "title": {
        "en": "Switched to generator power"
      }
    },
    {
      "id": "local_switched_to_utility",
      "title": {
        "en": "Switched back to utility power"
      }
    },
    {
      "id": "local_exercise_started",
      "title": {
        "en": "An exercise started"
      },
      "hint": {
        "en": "A scheduled self-test run."
      }
    },
    {
      "id": "local_exercise_completed",
      "title": {
        "en": "An exercise completed"
      },
      "hint": {
        "en": "A scheduled self-test run has finished."
      }
    },
    {
      "id": "local_fault_occurred",
      "title": {
        "en": "A fault occurred"
      },
      "highlight": true,
      "tokens": [
        {
          "name": "code",
          "type": "string",
          "title": {
            "en": "Fault code"
          },
          "example": "36"
        },
        {
          "name": "description",
          "type": "string",
          "title": {
            "en": "Description"
          },
          "example": "Low coolant level"
        }
      ]
    },
    {
      "id": "local_fault_cleared",
      "title": {
        "en": "The fault cleared"
      }
    },
    {
      "id": "local_action_required",
      "title": {
        "en": "Action required turned on"
      },
      "hint": {
        "en": "The generator's front panel is asking for attention."
      }
    },
    {
      "id": "local_status_changed",
      "title": {
        "en": "The status changed"
      },
      "tokens": [
        {
          "name": "status",
          "type": "string",
          "title": {
            "en": "Status"
          },
          "example": "Running"
        }
      ]
    },
    {
      "id": "local_event_logged",
      "title": {
        "en": "A new event was logged"
      },
      "tokens": [
        {
          "name": "code",
          "type": "string",
          "title": {
            "en": "Event code"
          },
          "example": "58"
        },
        {
          "name": "description",
          "type": "string",
          "title": {
            "en": "Description"
          },
          "example": "Genset exercise completed"
        }
      ]
    },
    {
      "id": "local_battery_below",
      "title": {
        "en": "The battery voltage dropped below..."
      },
      "titleFormatted": {
        "en": "The battery voltage dropped below [[voltage]] V"
      },
      "args": [
        {
          "name": "voltage",
          "type": "number",
          "min": 8,
          "max": 16,
          "step": 0.1,
          "placeholder": {
            "en": "12.0"
          },
          "title": {
            "en": "Voltage (V)"
          }
        }
      ],
      "tokens": [
        {
          "name": "voltage",
          "type": "number",
          "title": {
            "en": "Battery voltage"
          },
          "example": 11.9
        }
      ]
    },
    {
      "id": "local_load_above",
      "title": {
        "en": "The load rose above..."
      },
      "titleFormatted": {
        "en": "The load rose above [[percent]] %"
      },
      "args": [
        {
          "name": "percent",
          "type": "number",
          "min": 0,
          "max": 100,
          "step": 1,
          "placeholder": {
            "en": "80"
          },
          "title": {
            "en": "Load (%)"
          }
        }
      ],
      "tokens": [
        {
          "name": "load",
          "type": "number",
          "title": {
            "en": "Load %"
          },
          "example": 85
        }
      ],
      "hint": {
        "en": "Uses whichever of the two load lines is higher."
      }
    }
  ],
