  "actions": [
    {
      "id": "local_start_generator",
      "title": {
        "en": "Start the generator"
      },
      "hint": {
        "en": "Starts the engine via the generator's local interface. The generator's switch must be in REMOTE."
      }
    },
    {
      "id": "local_stop_generator",
      "title": {
        "en": "Stop the generator"
      },
      "hint": {
        "en": "Stops the engine via the generator's local interface. The generator's switch must be in REMOTE."
      }
    },
    {
      "id": "local_exercise_now",
      "title": {
        "en": "Run an exercise now"
      },
      "hint": {
        "en": "Starts the same self-test the generator runs on its own schedule. The generator's switch must be in REMOTE."
      }
    },
    {
      "id": "local_standby_on",
      "title": {
        "en": "Enable standby"
      },
      "hint": {
        "en": "Arms the generator so it will auto-start on a utility outage."
      }
    },
    {
      "id": "local_standby_off",
      "title": {
        "en": "Disable standby"
      },
      "hint": {
        "en": "Disarms auto-start. The generator will NOT start automatically during an outage while disabled."
      }
    },
    {
      "id": "local_set_exercise_schedule",
      "title": {
        "en": "Set the exercise schedule"
      },
      "titleFormatted": {
        "en": "Exercise [[frequency]] on [[day]] at [[hour]]:[[minute]]"
      },
      "args": [
        {
          "name": "frequency",
          "type": "dropdown",
          "values": [
            {
              "id": "never",
              "label": {
                "en": "Never"
              }
            },
            {
              "id": "weekly",
              "label": {
                "en": "Weekly"
              }
            },
            {
              "id": "bimonthly",
              "label": {
