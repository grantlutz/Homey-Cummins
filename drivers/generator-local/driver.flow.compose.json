        {
          "name": "hour",
          "type": "number",
          "min": 0,
          "max": 23,
          "step": 1,
          "placeholder": {
            "en": "10"
          },
          "title": {
            "en": "Hour (0-23)"
          }
        },
        {
          "name": "minute",
          "type": "dropdown",
          "values": [
            {
              "id": "0",
