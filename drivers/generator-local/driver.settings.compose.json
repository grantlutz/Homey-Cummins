      },
      {
        "id": "log_poll_cycles",
        "type": "number",
        "label": {
          "en": "Check event/fault logs every N polls"
        },
        "hint": {
          "en": "The event and fault logs are separate pages on the generator's web server; they change rarely, so they are fetched less often than live status."
        },
        "value": 10,
        "min": 1,
        "max": 100
      },
      {
        "id": "rated_kw",
        "type": "number",
        "label": {
          "en": "Generator rated output (kW)"
        },
        "hint": {
          "en": "Set your generator's nameplate rating (e.g. 20 for an RS20A) to estimate power output and energy produced from the reported load percentage. Leave at 0 to disable those two values."
        },
        "value": 0,
        "min": 0,
        "max": 200,
        "units": {
          "en": "kW"
        }
      }
    ]
  },
  {
    "type": "group",
    "label": {
      "en": "Generator clock"
    },
    "children": [
      {
        "id": "auto_sync_clock",
        "type": "checkbox",
        "label": {
          "en": "Automatically sync the generator clock"
        },
        "hint": {
          "en": "When the generator's clock drifts more than the threshold from Homey's time, set it automatically (like the HA bridge's nightly time sync)."
        },
        "value": false
      },
      {
        "id": "clock_drift_min",
        "type": "number",
        "label": {
